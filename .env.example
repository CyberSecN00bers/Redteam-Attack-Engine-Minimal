# CyberRange DAST Agent - Environment Configuration
# Copy this file to .env and fill in your values.

# Google Gemini API key (required for LLM analysis node)
GEMINI_API_KEY=

# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Runtime target configuration (used by Docker/Docker Compose)
TARGET_URL=http://127.0.0.1:80
HOST_HEADER=vulnerable.cyberrange.local
ATTACK_PROFILE=stealth
MAX_AMBIGUOUS_RESPONSES=2
VERIFY_CONFIRMATION_ATTEMPTS=2

# Qdrant vector DB for payload retrieval (optional - falls back to built-in payloads)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=waf_payloads
QDRANT_DENSE_MODEL=jinaai/jina-embeddings-v2-base-code
QDRANT_SPARSE_MODEL=Qdrant/bm25
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

LAB_CLIENT_IP=104.38.105.84
